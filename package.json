{
  "name": "melon-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm run build && pnpm -r --filter './packages/*' exec tsc --noEmit",
    "test": "pnpm run build && pnpm -r --filter './packages/*' run test",
    "lint:deps": "depcruise packages --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "dependency-cruiser": "^16.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
