{
  "name": "@melon-ai/admin",
  "version": "0.0.1",
  "description": "后台：额度（通用策略、单独策略、不限；按天、滚动时间窗）、花费汇总、站点设置，自带管理页面与接口，宿主挂到自己的服务上。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/embed-ui.mjs && tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@melon-ai/core": "workspace:*"
  },
  "devDependencies": {
    "@melon-ai/testkit": "workspace:*",
    "@melon-ai/store": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
