{
  "name": "@melon-ai/store-sqlite",
  "version": "0.0.1",
  "description": "全套存储端口的 SQLite 实现。只依赖 @melon-ai/core。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@melon-ai/core": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@melon-ai/testkit": "workspace:*",
    "better-sqlite3": "^11.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "peerDependencies": {
    "better-sqlite3": ">=11"
  }
}
