{
  "name": "melon-core",
  "version": "0.0.1",
  "description": "Melon AI 内核契约：类型与端口定义。零运行时依赖，所有模块的依赖倒置中心。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "node --test"
  },
  "license": "MIT"
}
