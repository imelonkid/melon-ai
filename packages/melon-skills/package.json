{
  "name": "@melon-ai/skills",
  "version": "0.0.1",
  "description": "技能：工具调用管线、准入策略、工具注册与审查（defineTool / defineSkill）；内置技能；Agent Skills 加载（./agentskills）。联网（./web）、发邮件（./mail）、本地文件（./files）、MCP 服务器（./mcp）需要 Node。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    },
    "./mail": {
      "types": "./dist/mail.d.ts",
      "import": "./dist/mail.js",
      "require": "./dist/mail.cjs"
    },
    "./agentskills": {
      "types": "./dist/agentskills.d.ts",
      "import": "./dist/agentskills.js",
      "require": "./dist/agentskills.cjs"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js",
      "require": "./dist/files.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --entry.index src/index.ts --entry.web src/builtin/web/index.ts --entry.mail src/builtin/mail/index.ts --entry.agentskills src/agentskills/index.ts --entry.files src/builtin/files/index.ts --entry.mcp src/mcp/index.ts --format esm,cjs --dts --clean",
    "test": "tsx --test test/*/*.test.ts"
  },
  "dependencies": {
    "@melon-ai/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "jszip": "^3.10.2",
    "mammoth": "1.13.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@melon-ai/audit": "workspace:*",
    "@melon-ai/testkit": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
