{
  "name": "@melon-ai/agent",
  "version": "0.0.1",
  "description": "宿主入口：装这一个包就能跑。可选能力在 ./sqlite、./anthropic、./web 等子路径。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "require": "./dist/sqlite.cjs"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js",
      "require": "./dist/anthropic.cjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    },
    "./mail": {
      "types": "./dist/mail.d.ts",
      "import": "./dist/mail.js",
      "require": "./dist/mail.cjs"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js",
      "require": "./dist/files.cjs"
    },
    "./agentskills": {
      "types": "./dist/agentskills.d.ts",
      "import": "./dist/agentskills.js",
      "require": "./dist/agentskills.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --entry.index src/index.ts --entry.sqlite src/sqlite.ts --entry.anthropic src/anthropic.ts --entry.web src/web.ts --entry.mail src/mail.ts --entry.files src/files.ts --entry.agentskills src/agentskills.ts --entry.mcp src/mcp.ts --entry.node src/node.ts --format esm,cjs --dts --clean",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@melon-ai/audit": "workspace:*",
    "@melon-ai/core": "workspace:*",
    "@melon-ai/engine": "workspace:*",
    "@melon-ai/llm": "workspace:*",
    "@melon-ai/skills": "workspace:*",
    "@melon-ai/store": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": ">=11",
    "@anthropic-ai/sdk": ">=0.128"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@melon-ai/testkit": "workspace:*",
    "better-sqlite3": "^11.8.1",
    "@types/better-sqlite3": "^7.6.12",
    "@anthropic-ai/sdk": "^0.128.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
