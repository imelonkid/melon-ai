{
  "name": "@melon-ai/llm-anthropic",
  "version": "0.0.1",
  "description": "Claude 的 ChatModel 适配器：Messages API、原生 tool use、prompt caching。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
