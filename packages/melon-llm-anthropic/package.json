  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "dependencies": {
    "@melon-ai/core": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.128"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
