{
  "name": "@melon-ai/store",
  "version": "0.0.1",
  "description": "存储：全套内存存储（默认，零依赖）；SQLite 持久化在 ./sqlite 子路径（需要 better-sqlite3）。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "require": "./dist/sqlite.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --entry.index src/index.ts --entry.sqlite src/sqlite/index.ts --format esm,cjs --dts --clean",
    "test": "tsx --test test/*/*.test.ts"
  },
  "dependencies": {
    "@melon-ai/core": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": ">=11"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^11.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
