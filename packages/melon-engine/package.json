{
  "name": "@melon-ai/engine",
  "version": "0.0.1",
  "description": "引擎：任务状态机、运行时调度、定时编排。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --entry.index src/index.ts --format esm,cjs --dts --clean",
    "test": "tsx --test test/*/*.test.ts"
  },
  "dependencies": {
    "@melon-ai/core": "workspace:*",
    "@melon-ai/skills": "workspace:*"
  },
  "devDependencies": {
    "@melon-ai/testkit": "workspace:*",
    "@melon-ai/audit": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
